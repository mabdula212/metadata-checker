# ==============================================================================
# METADATA CHECKER - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Server-only Secrets (NEVER expose to frontend; configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection Pooled URL (used by serverless functions)
# Note: For Neon connection pooler (*-pooler.neon.tech), ensure &pgbouncer=true&connect_timeout=30 is included
# Example: postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=30
DATABASE_URL=

# Neon PostgreSQL Direct Unpooled URL (used by Prisma CLI for migrations)
DIRECT_URL=

# Cryptographic Secret for signing / token authentication (Required in Production)
AUTH_SECRET=

# Vercel Blob Read/Write Access Token (Required when STORAGE_PROVIDER=vercel-blob)
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# Non-secret Runtime Configuration
# ------------------------------------------------------------------------------
# Storage Provider: "vercel-blob" for Vercel production, "local" for local dev/testing
STORAGE_PROVIDER=vercel-blob

# ------------------------------------------------------------------------------
# Development Only
# ------------------------------------------------------------------------------
# Filesystem path for LocalStorageProvider (ignored when STORAGE_PROVIDER=vercel-blob)
LOCAL_STORAGE_PATH=./storage/documents

